# Copy this file to config.env and fill it in. Never share config.env.

# Token from @BotFather (required)
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Telegram user IDs of the bot owners, comma separated (owner commands + always treated as admin)
OWNER_IDS=6316590677

# Optional: extra people (Telegram IDs, comma separated) who also receive and answer support DMs.
# Owners always receive them.
SUPPORT_IDS=

# Optional: only work in these group IDs (comma separated, e.g. -1001234567890).
# The bot leaves any other group. Leave empty to allow any group.
ALLOWED_CHATS=

# Optional: self-update source (defaults are already correct for the official repo).
# GITHUB_TOKEN is only needed if the repository is private.
UPDATE_REPO=nels0nfx/TurboFex-Telegram
UPDATE_BRANCH=main
GITHUB_TOKEN=
AUTO_UPDATE_HOURS=6

# Optional: AI answers. Free key: open https://aistudio.google.com/apikey , sign in, press "Create API key".
# The bot then answers members' questions about the TurboFex WhatsApp bot by itself.
# Leave empty to switch the AI off. (Defaults use Google Gemini's free tier.)
AI_API_KEY=
# A Groq key (starts with gsk_, free at console.groq.com) works here too: just paste it above.
# The bot detects the provider by itself. Optional overrides:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b

# Optional: where settings and warnings are stored
DATA_DIR=data
