# Copy this file to config.env and fill it in. Never share config.env.

# Token from @BotFather (required)
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Telegram user IDs of the bot owners, comma separated (owner commands + always treated as admin)
OWNER_IDS=6316590677

# Optional: only work in these group IDs (comma separated, e.g. -1001234567890).
# The bot leaves any other group. Leave empty to allow any group.
ALLOWED_CHATS=

# Optional: where settings and warnings are stored
DATA_DIR=data
